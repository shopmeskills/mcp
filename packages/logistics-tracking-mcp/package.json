{
  "name": "@shopme/logistics-tracking-mcp",
  "version": "1.0.0",
  "description": "MCP server for international package tracking with multi-carrier support",
  "type": "module",
  "bin": {
    "logistics-tracking-mcp": "./build/index.js",
    "logistics-tracking-mcp-serve": "./build/server-http.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/server-http.js",
    "dev": "tsx watch src/index.ts",
    "serve": "node build/server-http.js",
    "dev:serve": "tsx watch src/server-http.ts",
    "postinstall": "node -e \"console.log('\\n[logistics-tracking-mcp] No-key tracking: run once: npx playwright install chromium\\n')\""
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "logistics",
    "tracking",
    "shipping",
    "17track",
    "cross-border",
    "playwright"
  ],
  "author": "shopme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "playwright": "^1.50.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
