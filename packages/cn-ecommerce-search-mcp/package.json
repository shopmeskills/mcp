{
  "name": "@shopmeagent/cn-ecommerce-search-mcp",
  "version": "2.0.0",
  "description": "MCP server for searching products across Chinese e-commerce platforms (Taobao, Tmall, JD, PDD, 1688, AliExpress, Douyin, XHS) via Shopme API. No API keys required.",
  "type": "module",
  "bin": {
    "cn-ecommerce-search-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "files": ["build"],
  "keywords": ["mcp", "taobao", "tmall", "jd", "pdd", "1688", "aliexpress", "douyin", "xhs", "ecommerce", "product-search", "shopme"],
  "author": "shopme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
