# === Logistics Tracking MCP (international / cross-border) ===
# Optional: get API key from https://api.17track.net
# Without this key, Playwright browser is used for tracking (slower but works).
TRACK17_API_KEY=

# === US Domestic Tracking MCP (government / enterprise: UPS, USPS) ===
# USPS: https://developers.usps.com — OAuth Consumer Key/Secret
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=

# UPS: https://developer.ups.com — OAuth Client ID/Secret
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
