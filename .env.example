# === Logistics Tracking MCP (international / cross-border) ===
# Get API key from: https://api.17track.net
TRACK17_API_KEY=

# === US Domestic Tracking MCP (government / OpenClaw: UPS, USPS) ===
# USPS: https://developers.usps.com — OAuth Consumer Key/Secret
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=
# USPS test env: set to "true" to use apis-tem.usps.com
# USPS_USE_TEST_ENV=
# Optional: override track path if portal differs (default: tracking/v3/track)
# USPS_TRACK_PATH=

# UPS: https://developer.ups.com — OAuth Client ID/Secret
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# === CN Ecommerce Search MCP / Visual Product Search MCP ===
# Taobao IOP API credentials
# Apply at: https://open.taobao.com
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ACCESS_TOKEN=

# AliExpress DropShippers API
# Apply at: https://portals.aliexpress.com
ALIEXPRESS_DS_KEY=
ALIEXPRESS_DS_SECRET=

# === Visual Product Search MCP / Product Recommendation MCP ===
# Google Gemini API key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Xiaohongshu Data MCP ===
# Login to xiaohongshu.com in browser, copy cookie from DevTools
XHS_COOKIE=
